diff --git a/src/models/hy-v4-flash.cpp b/src/models/hy-v4-flash.cpp
new file mode 100644
index 000000000..4f962c731
--- /dev/null
+++ b/src/models/hy-v4-flash.cpp
@@ -0,0 +1,774 @@
+#include "models.h"
+#include "llama-impl.h"
+
+#include "llama-kv-cache.h"
+#include "llama-kv-cache-dsa.h"
+#include "llama-kv-cache-dsa-iswa.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cmath>
+#include <stdexcept>
+#include <string>
+
+// hy_v4_flash: Tencent Hy4-flash (HYV4FlashForCausalLM), text only.
+//
+// written for trench-gguf from the checkpoint's config.json and the semantics of a numpy reference (the Abyss
+// engine's ref/hy4.py); llama.cpp's own building blocks are reused: the absorbed-MLA attention of deepseek2, the
+// DSA + sliding-window K cache of dots3note (the indexer key cache holds the per-token indexer keys), the latent
+// MoE router input of kimi-k3, the swiglu clamp of deepseek4 and the lazily read n-gram table of deepseek41.
+//
+// one layer (the residual is hc = 4 streams of n_embd):
+//   Engram (layers ple.layers): the token and the two before it -> normalized ids -> 2-gram / 3-gram hashes ->
+//     16 rows of the table, RMS-normed per head (lookup_norm), engram_kv (+ bias) -> 4 keys + 1 value;
+//     stream c += (sigmoid(signed_sqrt(<norm(key_c), norm(R_c)> * gate_c / sqrt(n_embd))) + hc_scale_c) * main,
+//     main = pre_gamma * norm(value); nothing is added at pad / image / video tokens
+//   attention side hyper-connection: mixes = fn . rmsnorm(flat R); pre = sigmoid(mix*s0 + b) + eps;
+//     post = magnitude * sigmoid(mix*s1 + b) + eps; x = sum_c pre_c R_c
+//   attn_norm, gated MLA (q LoRA, shared 512 latent + 64 rope key, 1/sqrt(256), a learned sink per head,
+//     sigmoid(attn_gate x) on each output element), attn_output, post_attention_norm; R_c += post_c * attn
+//     sliding layers: 64 heads, a 512-key window, rope 1e4; the others: 32 heads, rope 1e7, and once a query sees
+//     more than indexer.top_k keys, the compressed indexer keeps its top (top_k/kpool - 1) groups of kpool keys
+//     plus its own group
+//   FFN side hyper-connection the same way, ffn_norm, layer 0 a dense SwiGLU, the others the latent MoE
+//     (sigmoid router on x, exp_probs_b for the choice only; the routed experts on ffn_routed_down x with the
+//     swiglu clamp, ffn_routed_up back; the shared expert on x), post_ffw_norm; R_c += post_c * ffn
+//   head: output_hc collapse of the 4 streams, output_norm, output
+//
+// limits: the indexer's group selection (contexts past indexer.top_k) assumes one sequence whose KV cells hold
+// positions 0.. in order (perplexity / imatrix chunks, a fresh generation); no MTP / dfly drafter, no vision
+
+static constexpr float       HY4_ENGRAM_EPS     = 0.0078125f; // 2^-7: the Engram key / query / value norms (bf16 eps)
+static constexpr float       HY4_ENGRAM_ROW_EPS = 1e-12f;     // the per-head norm of the looked-up rows
+static constexpr llama_token HY4_IMAGE_TOKEN    = 120120;     // config image_token_id
+static constexpr llama_token HY4_VIDEO_TOKEN    = 120124;     // config video_token_id
+
+void llama_model_hy_v4_flash::load_arch_hparams(llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, hparams.f_norm_rms_eps);
+    ml.get_key(LLM_KV_LEADING_DENSE_BLOCK_COUNT,   hparams.n_layer_dense_lead);
+
+    // MLA
+    ml.get_key(LLM_KV_ATTENTION_Q_LORA_RANK,      hparams.n_lora_q);
+    ml.get_key(LLM_KV_ATTENTION_KV_LORA_RANK,     hparams.n_lora_kv);
+    ml.get_key(LLM_KV_ATTENTION_KEY_LENGTH_MLA,   hparams.n_embd_head_k_mla_impl);
+    ml.get_key(LLM_KV_ATTENTION_VALUE_LENGTH_MLA, hparams.n_embd_head_v_mla_impl);
+
+    // MoE
+    ml.get_key_or_arr(LLM_KV_EXPERT_FEED_FORWARD_LENGTH, hparams.n_ff_exp_arr, hparams.n_layer_all);
+    ml.get_key(LLM_KV_EXPERT_SHARED_COUNT,  hparams.n_expert_shared);
+    ml.get_key(LLM_KV_EXPERT_WEIGHTS_SCALE, hparams.expert_weights_scale);
+    ml.get_key(LLM_KV_EXPERT_WEIGHTS_NORM,  hparams.expert_weights_norm, false);
+    ml.get_key(LLM_KV_EXPERT_GATING_FUNC,   hparams.expert_gating_func);
+    ml.get_key(LLM_KV_EXPERT_LATENT_LENGTH, hparams.n_expert_latent, false);
+    ml.get_key_or_arr(LLM_KV_SWIGLU_CLAMP_EXP, hparams.swiglu_clamp_exp, hparams.n_layer_all, false);
+    if (hparams.expert_gating_func != LLAMA_EXPERT_GATING_FUNC_TYPE_SIGMOID) {
+        throw std::runtime_error("hy_v4_flash: expected the sigmoid expert gating (expert_gating_func = 2)");
+    }
+
+    // sliding-window layers
+    hparams.swa_type = LLAMA_SWA_TYPE_STANDARD;
+    ml.get_key(LLM_KV_ATTENTION_SLIDING_WINDOW, hparams.n_swa);
+    ml.get_key(LLM_KV_ROPE_FREQ_BASE_SWA,       hparams.rope_freq_base_train_swa);
+    ml.get_arr(LLM_KV_ATTENTION_SLIDING_WINDOW_PATTERN, hparams.is_swa_impl);
+
+    // the compressed indexer of the other layers
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_HEAD_COUNT, hparams.indexer_n_head);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_KEY_LENGTH, hparams.indexer_head_size);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_TOP_K,      hparams.indexer_top_k);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_KPOOL,      hparams.indexer_kpool);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_KPOOL_SELECT_TAIL, hparams.indexer_kpool_select_tail, false);
+    ml.get_arr(LLM_KV_ATTENTION_INDEXER_TYPES,      hparams.is_indexer_full_impl);
+    if (hparams.indexer_kpool < 1 || hparams.indexer_top_k % hparams.indexer_kpool != 0 ||
+            hparams.indexer_top_k / hparams.indexer_kpool < 2 || hparams.indexer_head_size < hparams.n_rot()) {
+        throw std::runtime_error("hy_v4_flash: inconsistent indexer metadata (kpool, top_k, key_length)");
+    }
+    for (uint32_t il = 0; il < hparams.n_layer(); ++il) {
+        if (hparams.is_indexer_full(il) == hparams.is_swa(il)) {
+            throw std::runtime_error(format("hy_v4_flash: layer %u must be either a sliding-window or an indexed layer", il));
+        }
+    }
+
+    // hyper-connections (no stream-mixing matrix)
+    ml.get_key(LLM_KV_HYPER_CONNECTION_COUNT,     hparams.dsv4_hc_mult);
+    ml.get_key(LLM_KV_HYPER_CONNECTION_EPSILON,   hparams.dsv4_hc_eps);
+    ml.get_key(LLM_KV_HYPER_CONNECTION_MAGNITUDE, hparams.hc_magnitude);
+    if (hparams.dsv4_hc_mult == 0) {
+        throw std::runtime_error("hy_v4_flash: hyper_connection.count must be > 0");
+    }
+
+    // Engram: one hash module per Engram layer, the constants stored back to back
+    std::vector<uint32_t> e_layers;
+    ml.get_arr(LLM_KV_PLE_LAYERS, e_layers, false);
+    if (!e_layers.empty()) {
+        std::vector<uint64_t> mult;
+        std::vector<uint64_t> offsets;
+        std::vector<uint64_t> primes;
+        ml.get_key(LLM_KV_PLE_NGRAM_SIZE,             hparams.ple_ngram_size);
+        ml.get_key(LLM_KV_PLE_HEADS_PER_NGRAM,        hparams.ple_heads_per_ngram);
+        ml.get_key(LLM_KV_EMBEDDING_LENGTH_PER_LAYER, hparams.ple_head_dim);
+        ml.get_arr(LLM_KV_PLE_LAYER_MULTIPLIERS,      mult);
+        ml.get_arr(LLM_KV_PLE_HEAD_OFFSETS,           offsets);
+        ml.get_arr(LLM_KV_PLE_HEAD_VOCAB_SIZES,       primes);
+        ml.get_key(LLM_KV_ENGRAM_PAD_TOKEN_ID,        hparams.engram_pad_id);
+        ml.get_arr(LLM_KV_ENGRAM_TOKEN_MAP,           engram_token_map);
+
+        const size_t n_e    = e_layers.size();
+        const size_t n_gram = hparams.ple_ngram_size;
+        const size_t n_cols = n_gram >= 2 ? (n_gram - 1)*hparams.ple_heads_per_ngram : 0;
+        if (n_cols == 0 || hparams.ple_head_dim == 0 ||
+                mult.size() != n_e*n_gram || primes.size() != n_e*n_cols || offsets.size() != n_e*n_cols ||
+                mult.size() > LLAMA_MAX_PLE_NGRAM || primes.size() > LLAMA_MAX_PLE_HEADS ||
+                hparams.engram_pad_id >= engram_token_map.size()) {
+            throw std::runtime_error("hy_v4_flash: Engram metadata is inconsistent");
+        }
+        for (size_t e = 0; e < n_e; ++e) {
+            if (e_layers[e] >= hparams.n_layer() || (e > 0 && e_layers[e] <= e_layers[e - 1])) {
+                throw std::runtime_error(format("hy_v4_flash: Engram layer %u is out of range or out of order", e_layers[e]));
+            }
+            hparams.is_ple_impl.set(e_layers[e]);
+        }
+        for (size_t c = 0; c < n_e*n_cols; ++c) {
+            if (primes[c] < 2 || offsets[c] + primes[c] > (uint64_t) INT32_MAX) {
+                throw std::runtime_error(format("hy_v4_flash: Engram head %zu: bucket range out of range", c));
+            }
+            hparams.ple_head_offsets[c]     = (uint32_t) offsets[c];
+            hparams.ple_head_vocab_sizes[c] = (uint32_t) primes[c];
+        }
+        // the products must not wrap (the hash is defined on exact integers; uint64 holds them up to 2^64)
+        int64_t max_id = 0;
+        for (int32_t v : engram_token_map) {
+            max_id = std::max<int64_t>(max_id, v);
+        }
+        for (uint64_t m : mult) {
+            if (m != 0 && (uint64_t) max_id > UINT64_MAX/m) {
+                throw std::runtime_error("hy_v4_flash: an Engram multiplier times the largest normalized id passes 2^64");
+            }
+        }
+        std::copy(mult.begin(), mult.end(), hparams.ple_layer_multipliers.begin());
+        hparams.ple_n_heads   = (uint32_t) n_cols;
+        hparams.ple_n_modules = (uint32_t) n_e;
+    }
+
+    type = LLM_TYPE_UNKNOWN;
+}
+
+void llama_model_hy_v4_flash::load_arch_tensors(llama_model_loader & ml) {
+    LLAMA_LOAD_LOCALS;
+
+    if (!hparams.is_mla()) {
+        throw std::runtime_error("hy_v4_flash requires MLA (attention.key_length_mla / value_length_mla)");
+    }
+
+    const int64_t q_lora_rank     = hparams.n_lora_q;
+    const int64_t kv_lora_rank    = hparams.n_lora_kv;
+    const int64_t n_head_k_mla    = hparams.n_embd_head_k_mla();     // 256 = 192 nope + 64 rope
+    const int64_t n_head_v_mla    = hparams.n_embd_head_v_mla();     // 256
+    const int64_t n_rope          = hparams.n_rot();
+    const int64_t n_nope          = n_head_k_mla - n_rope;
+    const int64_t n_ff_exp        = hparams.n_ff_exp();
+    const int64_t n_latent        = hparams.n_expert_latent > 0 ? hparams.n_expert_latent : n_embd;
+    const int64_t n_expert_shared = hparams.n_expert_shared;
+    const int64_t hc              = hparams.dsv4_hc_mult;
+    const int64_t n_idx_embd      = hparams.indexer_head_size;
+    const int64_t n_idx_head      = hparams.indexer_n_head;
+    const int64_t kpool           = hparams.indexer_kpool;
+
+    tok_embd    = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD,  "weight"), {n_embd, n_vocab}, 0);
+    output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM, "weight"), {n_embd}, 0);
+    output      = create_tensor(tn(LLM_TENSOR_OUTPUT,      "weight"), {n_embd, n_vocab}, 0);
+
+    hc_head_fn    = create_tensor(tn(LLM_TENSOR_HC_HEAD_FN,    "weight"), {hc*n_embd, hc}, 0);
+    hc_head_base  = create_tensor(tn(LLM_TENSOR_HC_HEAD_BASE,  "weight"), {hc}, 0);
+    hc_head_scale = create_tensor(tn(LLM_TENSOR_HC_HEAD_SCALE, "weight"), {1}, 0);
+
+    // all Engram tables in one lazily read tensor (rows of ple_head_dim values; FP8 E4M3 / IQ4_NL / Q8_0 / F16 ...)
+    if (hparams.ple_n_heads > 0) {
+        int64_t n_rows = 0;
+        for (size_t c = 0; c < (size_t) hparams.ple_n_modules*hparams.ple_n_heads; ++c) {
+            n_rows = std::max(n_rows, (int64_t) hparams.ple_head_offsets[c] + hparams.ple_head_vocab_sizes[c]);
+        }
+        const std::string name = tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight").str();
+        if (const auto * w = ml.get_weight(name.c_str())) {
+            if (w->tensor->ne[1] < n_rows) {
+                throw std::runtime_error(format("%s has %" PRId64 " rows, too few for the Engram heads (%" PRId64 ")",
+                                                name.c_str(), w->tensor->ne[1], n_rows));
+            }
+            n_rows = w->tensor->ne[1];
+        }
+        per_layer_tok_embd = create_tensor(tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight"), {(int64_t) hparams.ple_head_dim, n_rows}, TENSOR_READ_LAZY);
+    }
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = layers[i];
+
+        const int64_t n_head_l = hparams.n_head(i);
+
+        layer.attn_norm      = create_tensor(tn(LLM_TENSOR_ATTN_NORM,      "weight", i), {n_embd}, 0);
+        layer.attn_q_a_norm  = create_tensor(tn(LLM_TENSOR_ATTN_Q_A_NORM,  "weight", i), {q_lora_rank}, 0);
+        layer.attn_kv_a_norm = create_tensor(tn(LLM_TENSOR_ATTN_KV_A_NORM, "weight", i), {kv_lora_rank}, 0);
+        layer.wq_a      = create_tensor(tn(LLM_TENSOR_ATTN_Q_A,      "weight", i), {n_embd, q_lora_rank}, 0);
+        layer.wq_b      = create_tensor(tn(LLM_TENSOR_ATTN_Q_B,      "weight", i), {q_lora_rank, n_head_l*n_head_k_mla}, 0);
+        layer.wkv_a_mqa = create_tensor(tn(LLM_TENSOR_ATTN_KV_A_MQA, "weight", i), {n_embd, kv_lora_rank + n_rope}, 0);
+        layer.wk_b      = create_tensor(tn(LLM_TENSOR_ATTN_K_B,      "weight", i), {n_nope, kv_lora_rank, n_head_l}, 0);
+        layer.wv_b      = create_tensor(tn(LLM_TENSOR_ATTN_V_B,      "weight", i), {kv_lora_rank, n_head_v_mla, n_head_l}, 0);
+        layer.wo        = create_tensor(tn(LLM_TENSOR_ATTN_OUT,      "weight", i), {n_head_l*n_head_v_mla, n_embd}, 0);
+        layer.wqkv_gate = create_tensor(tn(LLM_TENSOR_ATTN_GATE,     "weight", i), {n_embd, n_head_l*n_head_v_mla}, 0);
+        layer.attn_sinks     = create_tensor(tn(LLM_TENSOR_ATTN_SINKS,     "weight", i), {n_head_l}, 0);
+        layer.attn_post_norm = create_tensor(tn(LLM_TENSOR_ATTN_POST_NORM, "weight", i), {n_embd}, 0);
+
+        layer.hc_attn_fn    = create_tensor(tn(LLM_TENSOR_HC_ATTN_FN,    "weight", i), {hc*n_embd, 2*hc}, 0);
+        layer.hc_attn_base  = create_tensor(tn(LLM_TENSOR_HC_ATTN_BASE,  "weight", i), {2*hc}, 0);
+        layer.hc_attn_scale = create_tensor(tn(LLM_TENSOR_HC_ATTN_SCALE, "weight", i), {2}, 0);
+        layer.hc_ffn_fn     = create_tensor(tn(LLM_TENSOR_HC_FFN_FN,     "weight", i), {hc*n_embd, 2*hc}, 0);
+        layer.hc_ffn_base   = create_tensor(tn(LLM_TENSOR_HC_FFN_BASE,   "weight", i), {2*hc}, 0);
+        layer.hc_ffn_scale  = create_tensor(tn(LLM_TENSOR_HC_FFN_SCALE,  "weight", i), {2}, 0);
+
+        if (hparams.is_indexer_full(i)) {
+            layer.indexer_attn_k     = create_tensor(tn(LLM_TENSOR_INDEXER_ATTN_K,   "weight", i), {n_embd, n_idx_embd}, 0);
+            layer.indexer_k_norm     = create_tensor(tn(LLM_TENSOR_INDEXER_K_NORM,   "weight", i), {n_idx_embd}, 0);
+            layer.indexer_attn_q_b   = create_tensor(tn(LLM_TENSOR_INDEXER_ATTN_Q_B, "weight", i), {q_lora_rank, n_idx_head*n_idx_embd}, 0);
+            layer.indexer_proj       = create_tensor(tn(LLM_TENSOR_INDEXER_PROJ,     "weight", i), {n_embd, n_idx_head}, 0);
+            layer.indexer_comp_value = create_tensor(tn(LLM_TENSOR_INDEXER_COMPRESSOR_VALUE, "weight", i), {n_idx_embd, n_idx_embd}, 0);
+            layer.indexer_comp_wgate = create_tensor(tn(LLM_TENSOR_INDEXER_COMPRESSOR_WGATE, "weight", i), {n_idx_embd, n_idx_embd}, 0);
+            layer.indexer_comp_ape   = create_tensor(tn(LLM_TENSOR_INDEXER_COMPRESSOR_APE,   "weight", i), {n_idx_embd, kpool}, 0);
+            layer.indexer_comp_norm  = create_tensor(tn(LLM_TENSOR_INDEXER_COMPRESSOR_NORM,  "weight", i), {n_idx_embd}, 0);
+        }
+
+        if (hparams.is_ple(i)) {
+            const int64_t n_rows_in = (int64_t) hparams.ple_n_heads*hparams.ple_head_dim;
+            layer.engram_kv          = create_tensor(tn(LLM_TENSOR_ENGRAM_KV,          "weight", i), {n_rows_in, n_embd*(hc + 1)}, 0);
+            layer.engram_kv_b        = create_tensor(tn(LLM_TENSOR_ENGRAM_KV_B,        "weight", i), {n_embd, hc + 1}, 0);
+            layer.engram_gate        = create_tensor(tn(LLM_TENSOR_ENGRAM_GATE,        "weight", i), {n_embd, hc}, 0);
+            layer.engram_lookup_norm = create_tensor(tn(LLM_TENSOR_ENGRAM_LOOKUP_NORM, "weight", i), {(int64_t) hparams.ple_head_dim, (int64_t) hparams.ple_n_heads}, 0);
+            layer.engram_hc_scale    = create_tensor(tn(LLM_TENSOR_ENGRAM_HC_SCALE,    "weight", i), {n_embd, hc}, 0);
+            layer.engram_pre_gamma   = create_tensor(tn(LLM_TENSOR_ENGRAM_PRE_GAMMA,   "weight", i), {n_embd}, 0);
+        }
+
+        layer.ffn_norm      = create_tensor(tn(LLM_TENSOR_FFN_NORM,      "weight", i), {n_embd}, 0);
+        layer.ffn_post_norm = create_tensor(tn(LLM_TENSOR_FFN_POST_NORM, "weight", i), {n_embd}, 0);
+
+        if (i < (int) hparams.n_layer_dense_lead) {
+            layer.ffn_gate = create_tensor(tn(LLM_TENSOR_FFN_GATE, "weight", i), {n_embd,   n_ff}, 0);
+            layer.ffn_down = create_tensor(tn(LLM_TENSOR_FFN_DOWN, "weight", i), {  n_ff, n_embd}, 0);
+            layer.ffn_up   = create_tensor(tn(LLM_TENSOR_FFN_UP,   "weight", i), {n_embd,   n_ff}, 0);
+        } else {
+            if (n_expert == 0 || n_expert_used == 0) {
+                throw std::runtime_error("n_expert and n_expert_used must be > 0");
+            }
+            layer.ffn_gate_inp    = create_tensor(tn(LLM_TENSOR_FFN_GATE_INP,    "weight", i), {n_embd, n_expert}, 0);
+            layer.ffn_exp_probs_b = create_tensor(tn(LLM_TENSOR_FFN_EXP_PROBS_B, "bias",   i), {n_expert}, 0);
+
+            layer.ffn_routed_down = create_tensor(tn(LLM_TENSOR_FFN_ROUTED_DOWN, "weight", i), {n_embd, n_latent}, 0);
+            layer.ffn_routed_up   = create_tensor(tn(LLM_TENSOR_FFN_ROUTED_UP,   "weight", i), {n_latent, n_embd}, 0);
+
+            layer.ffn_gate_exps = create_tensor(tn(LLM_TENSOR_FFN_GATE_EXPS, "weight", i), {n_latent, n_ff_exp, n_expert}, 0);
+            layer.ffn_down_exps = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", i), {n_ff_exp, n_latent, n_expert}, 0);
+            layer.ffn_up_exps   = create_tensor(tn(LLM_TENSOR_FFN_UP_EXPS,   "weight", i), {n_latent, n_ff_exp, n_expert}, 0);
+
+            layer.ffn_gate_shexp = create_tensor(tn(LLM_TENSOR_FFN_GATE_SHEXP, "weight", i), {n_embd, n_ff_exp*n_expert_shared}, 0);
+            layer.ffn_down_shexp = create_tensor(tn(LLM_TENSOR_FFN_DOWN_SHEXP, "weight", i), {n_ff_exp*n_expert_shared, n_embd}, 0);
+            layer.ffn_up_shexp   = create_tensor(tn(LLM_TENSOR_FFN_UP_SHEXP,   "weight", i), {n_embd, n_ff_exp*n_expert_shared}, 0);
+        }
+    }
+}
