+from __future__ import annotations
+
+# Tencent Hy4-flash (HYV4FlashForCausalLM) -> hy_v4_flash GGUF, text only (trench-gguf).
+#
+# Written from the checkpoint's config.json and safetensors names / shapes; each layout below was checked against
+# the checkpoint's own tensors (HTTP range reads of layer 1 and 11) and an existing hy_v4_flash GGUF:
+#   kv_b_proj [h*448, 512]           -> attn_k_b [h][512][192] (rows h*448 + 0..191, transposed) and
+#                                       attn_v_b [h][256][512] (rows h*448 + 192..447)
+#   mlp.experts.gate_up_proj [E, 2*ff, in] -> ffn_gate_exps = [:, :ff], ffn_up_exps = [:, ff:]   (not interleaved)
+#   mlp.experts.down_proj [E, out, ff]     -> ffn_down_exps as it is
+#   engram key_projs.0..3 + value_proj      -> engram_kv [15360, 1536] (keys first), their biases -> engram_kv_b [5, 3072]
+#   engram norm_key.c * norm_query.c        -> engram_gate [4, 3072] (F32)
+#   engram multi_head_embedding [rows, 96] of the 4 Engram layers -> one per_layer_token_embd (rows in layer order)
+#   engram lookup_table [120818]            -> engram.token_map (padded to the vocabulary with the pad token's id)
+# Not converted: the vision tower (vit.*), the dfly drafter (model.dfly_layers.*).
+
+import json
+import math
+import os
+import re
+from pathlib import Path
+from typing import Callable, Iterable, TYPE_CHECKING, cast
+
+import numpy as np
+import torch
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+from .base import LazyTorchTensor, ModelBase, TextModel, gguf, logger
+from .deepseek41 import _StreamedBytes
+
+
+def _is_prime(n: int) -> bool:
+    if n < 2 or n % 2 == 0:
+        return n == 2
+    return all(n % d for d in range(3, math.isqrt(n) + 1, 2))
+
+
+def hy4_engram_primes(n_layers: int, vocab_sizes: list[int], n_heads: int) -> list[int]:
+    """Bucket counts, [layer][ngram order 2..][head] flattened: for each head the next prime above the previous
+    one (starting at the order's engram_vocab_size), never reused across heads, orders or layers."""
+    seen: set[int] = set()
+    out: list[int] = []
+    for _ in range(n_layers):
+        for vocab in vocab_sizes:
+            cur = vocab - 1
+            for _ in range(n_heads):
+                cand = cur + 1
+                while not _is_prime(cand) or cand in seen:
+                    cand += 1
+                cur = cand
+                seen.add(cur)
+                out.append(cur)
+    return out
+
+
+# The hash multipliers are not stored in the checkpoint (they follow from engram_seed); these are the values of
+# engram_seed = 0 with engram layers 2/12/22/32 and 3-grams, as the published hy_v4_flash GGUFs carry them. For
+# another seed / layout, point TRENCH_HY4_MULTIPLIERS_FROM at a GGUF of that checkpoint to copy its values.
+_HY4_MULTIPLIERS_SEED0 = [
+    81853575799317, 39690085502883, 24229915018165,
+    19457948045719, 44729556510419, 84779352922315,
+    72974230057307, 21530602121221, 55998057243097,
+    29128509562787, 16745155128523, 22474588302733,
+]
+
+
+def _multipliers_from_gguf(path: str) -> list[int]:
+    reader = gguf.GGUFReader(path)
+    field = reader.get_field("hy_v4_flash.ple.layer_multipliers")
+    if field is None:
+        raise ValueError(f"{path}: no hy_v4_flash.ple.layer_multipliers")
+    return [int(field.parts[i][0]) for i in field.data]
+
+
+@ModelBase.register("HYV4FlashForCausalLM")
+class HYV4FlashModel(TextModel):
+    """Hy4-flash text model. Weights are written as they are (BF16; norms, hyper-connection mixers, router, indexer
+    and the Engram gate in F32); the Engram tables are streamed (4 x 31.7 GB in BF16) into one per_layer_token_embd."""
+    model_arch = gguf.MODEL_ARCH.HY_V4_FLASH
+
+    _SKIP_RE = re.compile(r"^(model\.)?(dfly_layers\.|vit\.|vision|mm_projector|visual)")
+    _ENGRAM_RE = re.compile(r"^model\.layers\.(\d+)\.engram_layer\.(.+)$")
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        hp = self.hparams
+        self._n_layer = hp["num_hidden_layers"]
+        self._engram_layers = [i - 1 for i in hp.get("engram_layer_ids") or []]   # config ids are 1-based
+        self._swa = [t == "sliding_attention" for t in self._layer_types()]
+        self._f32 = self.ftype == gguf.LlamaFileType.ALL_F32
+
+    def _layer_types(self) -> list[str]:
+        hp = self.hparams
+        if "layer_types" in hp:
+            return list(hp["layer_types"])
+        raise ValueError("config.json has no layer_types (which layers are sliding_attention)")
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        name, _ = item
+        if cls._SKIP_RE.match(name):
+            return None
+        return super().filter_tensors(item)
+
+    def set_vocab(self):
+        self._set_vocab_gpt2()
+
+    def set_gguf_parameters(self):
+        hp = self.hparams
+        w = self.gguf_writer
+        n = self._n_layer
+        rp = hp["rope_parameters"]
+        swa_heads = hp.get("swa_num_attention_heads", hp.get("sliding_num_attention_heads"))
+        heads = [int(swa_heads if s else hp["num_attention_heads"]) for s in self._swa]
+        if any(h is None for h in heads):
+            raise ValueError("config.json: no head count for the sliding-window layers")
+
+        w.add_block_count(n)
+        w.add_context_length(hp["max_position_embeddings"])
+        w.add_embedding_length(hp["hidden_size"])
+        w.add_feed_forward_length(hp["intermediate_size"])
+        w.add_head_count(heads)
+        w.add_head_count_kv(1)
+        w.add_vocab_size(hp["vocab_size"])
+        w.add_layer_norm_rms_eps(hp["rms_norm_eps"])
+        # MLA (absorbed): one shared 512 latent + 64 rope key
+        w.add_q_lora_rank(hp["q_lora_rank"])
+        w.add_kv_lora_rank(hp["kv_lora_rank"])
+        w.add_key_length(hp["kv_lora_rank"] + hp["qk_rope_head_dim"])
+        w.add_value_length(hp["kv_lora_rank"])
+        w.add_key_length_mla(hp["qk_nope_head_dim"] + hp["qk_rope_head_dim"])
+        w.add_value_length_mla(hp["v_head_dim"])
+        w.add_rope_dimension_count(hp["qk_rope_head_dim"])
+        w.add_rope_freq_base(float(rp["deepseek_sparse_attention"]["rope_theta"]))
+        w.add_rope_freq_base_swa(float(rp["sliding_attention"]["rope_theta"]))
+        w.add_sliding_window(hp["sliding_window"])
+        w.add_sliding_window_pattern(self._swa)
+        # the compressed indexer of the other layers
+        w.add_indexer_head_count(hp["index_n_heads"])
+        w.add_indexer_key_length(hp["index_head_dim"])
+        w.add_indexer_top_k(hp["index_topk"])
+        w.add_indexer_types([not s for s in self._swa])
+        w.add_indexer_kpool(hp["compressed_indexer_compress_ratio"])
+        w.add_indexer_kpool_select_tail(True)
+        # MoE
+        w.add_leading_dense_block_count(hp["first_k_dense_replace"])
+        w.add_expert_count(hp["n_routed_experts"])
+        w.add_expert_used_count(hp["num_experts_per_tok"])
+        w.add_expert_feed_forward_length(hp["moe_intermediate_size"])
+        w.add_expert_shared_count(hp["n_shared_experts"])
+        w.add_expert_weights_scale(hp["routed_scaling_factor"])
+        w.add_expert_weights_norm(bool(hp["norm_topk_prob"]))
+        w.add_expert_gating_func(gguf.ExpertGatingFuncType.SIGMOID)
+        w.add_expert_latent_length(hp["routed_expert_hidden_size"])
+        w.add_swiglu_clamp_exp([float(hp["swiglu_limit"])] * n)
+        # hyper-connections
+        w.add_hyper_connection_count(hp["hc_mult"])
+        w.add_hyper_connection_epsilon(hp["hc_eps"])
+        w.add_hyper_connection_magnitude(hp["hc_magnitude"])
+        # Engram
+        if self._engram_layers:
+            self._set_engram_parameters()
+        w.add_file_type(self.ftype)
+
+    def _set_engram_parameters(self):
+        hp = self.hparams
+        w = self.gguf_writer
+        layers = self._engram_layers
+        n_gram = hp["engram_max_ngram_size"]
+        n_head = hp["engram_n_head_per_ngram"]
+        head_dim = hp["engram_n_embed_per_ngram"] // n_head
+        vocab_sizes = list(hp["engram_vocab_size"])
+        if len(vocab_sizes) != n_gram - 1:
+            raise ValueError("engram_vocab_size must list one size per n-gram order 2..max")
+
+        sizes = hy4_engram_primes(len(layers), vocab_sizes, n_head)
+        # the config lists them too (engram_layer_head_vocab_sizes, keyed by the 1-based layer id): must agree
+        listed = hp.get("engram_layer_head_vocab_sizes")
+        if listed:
+            flat = [int(v) for bid in layers for per in listed[str(bid + 1)] for v in per]
+            if flat != sizes:
+                raise ValueError("engram_layer_head_vocab_sizes does not match the prime layout")
+        per_layer = len(vocab_sizes) * n_head
+        for li, bid in enumerate(layers):
+            rows = self._table_rows(bid)
+            if rows != sum(sizes[li * per_layer:(li + 1) * per_layer]):
+                raise ValueError(f"layer {bid}: Engram table has {rows} rows, the bucket primes sum to "
+                                 f"{sum(sizes[li * per_layer:(li + 1) * per_layer])}")
+        offsets = [sum(sizes[:i]) for i in range(len(sizes))]
+
+        src = os.environ.get("TRENCH_HY4_MULTIPLIERS_FROM")
+        if src:
+            mult = _multipliers_from_gguf(src)
+        elif hp.get("engram_seed", 0) == 0 and [i + 1 for i in layers] == [2, 12, 22, 32] and n_gram == 3:
+            mult = list(_HY4_MULTIPLIERS_SEED0)
+        else:
+            raise ValueError("unknown Engram hash multipliers for this engram_seed / layout: "
+                             "set TRENCH_HY4_MULTIPLIERS_FROM=<a GGUF of this checkpoint>")
+        if len(mult) != len(layers) * n_gram:
+            raise ValueError(f"{len(mult)} Engram multipliers, expected {len(layers) * n_gram}")
+
+        token_map = self._token_map()
+        w.add_ple_layers(layers)
+        w.add_ple_ngram_size(n_gram)
+        w.add_ple_heads_per_ngram(n_head)
+        w.add_embedding_length_per_layer_input(head_dim)
+        w.add_ple_layer_multipliers(mult)
+        w.add_ple_head_offsets(offsets)
+        w.add_ple_head_vocab_sizes(sizes)
+        w.add_engram_pad_token_id(hp["engram_pad_id"])
+        w.add_engram_token_map(token_map)
+
+    def _table_name(self, bid: int) -> str:
+        return f"model.layers.{bid}.engram_layer.multi_head_embedding.embedding.weight"
+
+    def _table_rows(self, bid: int) -> int:
+        return int(self.model_tensors[self._table_name(bid)]().shape[0])
+
+    def _token_map(self) -> list[int]:
+        hp = self.hparams
+        maps = []
+        for bid in self._engram_layers:
+            t = LazyTorchTensor.to_eager(self.model_tensors[f"model.layers.{bid}.engram_layer.lookup_table"]())
+            maps.append(t.numpy().astype(np.int64))
+        for m in maps[1:]:
+            if not np.array_equal(m, maps[0]):
+                raise ValueError("the Engram layers have different lookup tables (one token map is supported)")
+        m = maps[0].tolist()
+        pad = hp["engram_pad_id"]
+        if len(m) > hp["vocab_size"] or pad >= len(m):
+            raise ValueError(f"lookup_table has {len(m)} entries for a vocabulary of {hp['vocab_size']}")
+        # ids past the table (added special tokens) hash like the pad token
+        return m + [m[pad]] * (hp["vocab_size"] - len(m))
+
+    def _tensor_part(self, name: str) -> Path:
+        index = self.dir_model / "model.safetensors.index.json"
+        if not index.is_file():
+            return self.dir_model / "model.safetensors"
+        with open(index, "r", encoding="utf-8") as f:
+            return self.dir_model / json.load(f)["weight_map"][name]
+
+    def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:
+        if not self._engram_layers or getattr(self, "_table_written", False):
+            return ()
+        self._table_written = True
+        parts = []
+        for bid in self._engram_layers:
+            name = self._table_name(bid)
+            rows, dim = (int(x) for x in self.model_tensors[name]().shape)
+            parts.append((name, rows, dim, self._tensor_part(name)))
+        dim = parts[0][2]
+        if any(p[2] != dim for p in parts):
+            raise ValueError("the Engram tables differ in width")
+        n_rows = sum(p[1] for p in parts)
+        f32 = self._f32
+
+        def chunks() -> Iterable[np.ndarray]:
+            from safetensors import safe_open
+            for name, rows, _, part in parts:
+                with safe_open(part, framework="pt") as f:
+                    sl = f.get_slice(name)
+                    for r0 in range(0, rows, 1 << 20):
+                        v = sl[r0:r0 + (1 << 20)]
+                        v = v.float() if f32 else v.to(torch.bfloat16)
+                        yield v.contiguous().view(torch.uint8).numpy()
+        qt = gguf.GGMLQuantizationType.F32 if f32 else gguf.GGMLQuantizationType.BF16
+        data = cast(np.ndarray, _StreamedBytes((n_rows, dim * (4 if f32 else 2)), chunks))
+        self.gguf_writer.add_tensor(self.format_tensor_name(gguf.MODEL_TENSOR.PER_LAYER_TOKEN_EMBD), data, raw_dtype=qt)
+        return ()
+
+    _ROOT = {
+        "model.embed_tokens.weight": gguf.MODEL_TENSOR.TOKEN_EMBD,
+        "lm_head.weight": gguf.MODEL_TENSOR.OUTPUT,
+        "model.norm.weight": gguf.MODEL_TENSOR.OUTPUT_NORM,
+        "model.hc_head.hc_head_fn": gguf.MODEL_TENSOR.HC_HEAD_FN,
+        "model.hc_head.hc_head_base": gguf.MODEL_TENSOR.HC_HEAD_BASE,
+        "model.hc_head.hc_head_scale": gguf.MODEL_TENSOR.HC_HEAD_SCALE,
+    }
+
+    _LAYER: dict[str, tuple[gguf.MODEL_TENSOR, str]] = {
+        "input_layernorm.weight": (gguf.MODEL_TENSOR.ATTN_NORM, ".weight"),
+        "post_attention_layernorm.weight": (gguf.MODEL_TENSOR.FFN_NORM, ".weight"),
+        "self_attn.post_proj_norm.weight": (gguf.MODEL_TENSOR.ATTN_POST_NORM, ".weight"),
+        "mlp.combine_output_norm.weight": (gguf.MODEL_TENSOR.FFN_POST_NORM, ".weight"),
+        "mlp.post_fc2_norm.weight": (gguf.MODEL_TENSOR.FFN_POST_NORM, ".weight"),
+        "self_attn.q_a_proj.weight": (gguf.MODEL_TENSOR.ATTN_Q_A, ".weight"),
+        "self_attn.q_a_layernorm.weight": (gguf.MODEL_TENSOR.ATTN_Q_A_NORM, ".weight"),
+        "self_attn.q_b_proj.weight": (gguf.MODEL_TENSOR.ATTN_Q_B, ".weight"),
+        "self_attn.kv_a_proj_with_mqa.weight": (gguf.MODEL_TENSOR.ATTN_KV_A_MQA, ".weight"),
+        "self_attn.kv_a_layernorm.weight": (gguf.MODEL_TENSOR.ATTN_KV_A_NORM, ".weight"),
+        "self_attn.learnable_sink_param": (gguf.MODEL_TENSOR.ATTN_SINKS, ".weight"),
+        "self_attn.linear_gate.weight": (gguf.MODEL_TENSOR.ATTN_GATE, ".weight"),
+        "self_attn.o_proj.weight": (gguf.MODEL_TENSOR.ATTN_OUT, ".weight"),
+        "self_attn.compressed_indexer.query_projection.weight": (gguf.MODEL_TENSOR.INDEXER_ATTN_Q_B, ".weight"),
+        "self_attn.compressed_indexer.token_key_projection.weight": (gguf.MODEL_TENSOR.INDEXER_ATTN_K, ".weight"),
+        "self_attn.compressed_indexer.token_key_norm.weight": (gguf.MODEL_TENSOR.INDEXER_K_NORM, ".weight"),
+        "self_attn.compressed_indexer.head_weight_projection.weight": (gguf.MODEL_TENSOR.INDEXER_PROJ, ".weight"),
+        "self_attn.compressed_indexer.key_value_projection.weight": (gguf.MODEL_TENSOR.INDEXER_COMPRESSOR_VALUE, ".weight"),
+        "self_attn.compressed_indexer.key_gate_projection.weight": (gguf.MODEL_TENSOR.INDEXER_COMPRESSOR_WGATE, ".weight"),
+        "self_attn.compressed_indexer.intra_group_ape": (gguf.MODEL_TENSOR.INDEXER_COMPRESSOR_APE, ".weight"),
+        "self_attn.compressed_indexer.key_norm.weight": (gguf.MODEL_TENSOR.INDEXER_COMPRESSOR_NORM, ".weight"),
+        "hc_attn_layer.hc_pre.hc_fn": (gguf.MODEL_TENSOR.HC_ATTN_FN, ".weight"),
+        "hc_attn_layer.hc_pre.hc_base": (gguf.MODEL_TENSOR.HC_ATTN_BASE, ".weight"),
+        "hc_attn_layer.hc_pre.hc_scale": (gguf.MODEL_TENSOR.HC_ATTN_SCALE, ".weight"),
+        "hc_mlp_layer.hc_pre.hc_fn": (gguf.MODEL_TENSOR.HC_FFN_FN, ".weight"),
+        "hc_mlp_layer.hc_pre.hc_base": (gguf.MODEL_TENSOR.HC_FFN_BASE, ".weight"),
+        "hc_mlp_layer.hc_pre.hc_scale": (gguf.MODEL_TENSOR.HC_FFN_SCALE, ".weight"),
+        "mlp.gate.weight": (gguf.MODEL_TENSOR.FFN_GATE_INP, ".weight"),
+        "mlp.gate.e_score_correction_bias": (gguf.MODEL_TENSOR.FFN_EXP_PROBS_B, ".bias"),
+        "mlp.gate.e_score_correction.bias": (gguf.MODEL_TENSOR.FFN_EXP_PROBS_B, ".bias"),   # as the loader renames it
+        "mlp.routed_expert_down_proj.weight": (gguf.MODEL_TENSOR.FFN_ROUTED_DOWN, ".weight"),
+        "mlp.routed_expert_up_proj.weight": (gguf.MODEL_TENSOR.FFN_ROUTED_UP, ".weight"),
+        "mlp.shared_experts.gate_proj.weight": (gguf.MODEL_TENSOR.FFN_GATE_SHEXP, ".weight"),
+        "mlp.shared_experts.up_proj.weight": (gguf.MODEL_TENSOR.FFN_UP_SHEXP, ".weight"),
+        "mlp.shared_experts.down_proj.weight": (gguf.MODEL_TENSOR.FFN_DOWN_SHEXP, ".weight"),
+        "mlp.gate_proj.weight": (gguf.MODEL_TENSOR.FFN_GATE, ".weight"),
+        "mlp.up_proj.weight": (gguf.MODEL_TENSOR.FFN_UP, ".weight"),
+        "mlp.down_proj.weight": (gguf.MODEL_TENSOR.FFN_DOWN, ".weight"),
+        "mlp.experts.down_proj": (gguf.MODEL_TENSOR.FFN_DOWN_EXP, ".weight"),
+    }
+
+    # tensors kept in F32 (small, or used elementwise / for the routing choice)
+    _F32 = (".hc_attn_fn.", ".hc_attn_base.", ".hc_attn_scale.", ".hc_ffn_fn.", ".hc_ffn_base.", ".hc_ffn_scale.",
+            "output_hc_", ".attn_sinks.", ".ffn_gate_inp.", ".exp_probs_b.", ".indexer.", ".indexer_compressor_",
+            ".engram_gate.", ".engram_kv_b.", ".engram_hc_scale.", ".engram_lookup_norm.", ".engram_pre_gamma.")
+
+    def _get(self, name: str) -> Tensor:
+        return self.model_tensors[name]()
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if name in self._ROOT:
+            yield self.format_tensor_name(self._ROOT[name]), data_torch
+            return
+        m = re.match(r"^model\.layers\.(\d+)\.(.+)$", name)
+        if m is None:
+            raise ValueError(f"unexpected tensor {name}")
+        bid, rest = int(m.group(1)), m.group(2)
+        hp = self.hparams
+
+        if rest in self._LAYER:
+            key, suffix = self._LAYER[rest]
+            yield self.format_tensor_name(key, bid, suffix), data_torch
+            return
+
+        if rest == "self_attn.kv_b_proj.weight":
+            n_nope, n_v, lat = hp["qk_nope_head_dim"], hp["v_head_dim"], hp["kv_lora_rank"]
+            kv = data_torch.reshape(-1, n_nope + n_v, lat)
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_K_B, bid), kv[:, :n_nope, :].transpose(1, 2).contiguous()
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_V_B, bid), kv[:, n_nope:, :].contiguous()
+            return
+
+        if rest == "mlp.experts.gate_up_proj":
+            ff = data_torch.shape[1] // 2
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.FFN_GATE_EXP, bid), data_torch[:, :ff, :].contiguous()
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.FFN_UP_EXP, bid), data_torch[:, ff:, :].contiguous()
+            return
+
+        if rest.startswith("engram_layer."):
+            yield from self._engram(bid, rest.removeprefix("engram_layer."), data_torch)
+            return
+
+        raise ValueError(f"unexpected tensor {name}")
+
+    def _engram(self, bid: int, rest: str, data_torch: Tensor) -> Iterable[tuple[str, Tensor]]:
+        hc = self.hparams["hc_mult"]
+        n_heads = (self.hparams["engram_max_ngram_size"] - 1) * self.hparams["engram_n_head_per_ngram"]
+        p = f"model.layers.{bid}.engram_layer."
+        # each fused tensor is written when its first part arrives; the other parts are skipped
+        if rest == "key_projs.0.weight":
+            ws = [self._get(p + f"key_projs.{c}.weight") for c in range(hc)] + [self._get(p + "value_proj.weight")]
+            bs = [self._get(p + f"key_projs.{c}.bias") for c in range(hc)] + [self._get(p + "value_proj.bias")]
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_KV, bid), torch.cat([w.float() for w in ws], 0)
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_KV_B, bid), torch.stack([b.float() for b in bs], 0)
+        elif rest == "norm_key.0.weight":
+            g = [self._get(p + f"norm_key.{c}.weight").float() * self._get(p + f"norm_query.{c}.weight").float() for c in range(hc)]
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_GATE, bid), torch.stack(g, 0)
+        elif rest == "unified_per_hc_scales.0":
+            s = [self._get(p + f"unified_per_hc_scales.{c}").float() for c in range(hc)]
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_HC_SCALE, bid), torch.stack(s, 0)
+        elif rest == "lookup_per_head_norms.0.weight":
+            s = [self._get(p + f"lookup_per_head_norms.{c}.weight").float() for c in range(n_heads)]
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_LOOKUP_NORM, bid), torch.stack(s, 0)
+        elif rest == "unified_pre_gamma":
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ENGRAM_PRE_GAMMA, bid), data_torch
+        elif re.fullmatch(r"(key_projs\.\d+\.(weight|bias)|value_proj\.(weight|bias)|norm_(key|query)\.\d+\.weight|"
+                          r"unified_per_hc_scales\.\d+|lookup_per_head_norms\.\d+\.weight)", rest):
+            return
+        elif rest in ("multi_head_embedding.embedding.weight", "lookup_table"):
+            return  # streamed by generate_extra_tensors / read for the token map
+        else:
+            raise ValueError(f"unexpected Engram tensor {p}{rest}")
+
+    def tensor_force_quant(self, name: str, new_name: str, bid: int | None, n_dims: int) -> gguf.GGMLQuantizationType | bool:
+        if any(k in new_name for k in self._F32):
+            return gguf.GGMLQuantizationType.F32
+        if n_dims >= 2:
+            return gguf.GGMLQuantizationType.F32 if self._f32 else gguf.GGMLQuantizationType.BF16
+        return False
+
+
+logger.debug("hy_v4_flash conversion loaded")
