+class F8_E4M3(__Quant, qtype=GGMLQuantizationType.F8_E4M3):
+    # OCP E4M3FN (bias 7, max 448, no infinities); round to nearest even, saturating - as quantize_row_f8_e4m3_ref
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        x = blocks.astype(np.float32).reshape(-1)
+        codes = np.arange(256, dtype=np.uint8)
+        vals = cls.dequantize_blocks(codes.reshape(-1, 1)).reshape(-1)
+        pos = np.where(np.isnan(vals) | (vals < 0) | ((codes & 128) != 0), np.inf, vals)
+        order = np.argsort(pos[:127])                          # the 127 non-negative finite codes 0x00..0x7e
+        grid, gcode = pos[:127][order], codes[:127][order]
+        a = np.minimum(np.abs(x), 448.0)
+        i = np.clip(np.searchsorted(grid, a), 1, grid.size - 1)
+        lo, hi = grid[i - 1], grid[i]
+        pick_hi = (a - lo > hi - a) | ((a - lo == hi - a) & ((gcode[i] & 1) == 0))
+        c = np.where(pick_hi, gcode[i], gcode[i - 1]).astype(np.uint8)
+        c = np.where(np.signbit(x), c | 128, c).astype(np.uint8)
+        c = np.where(np.isnan(x), np.uint8(0x7F) | np.where(np.signbit(x), np.uint8(128), np.uint8(0)), c)
+        return c.astype(np.uint8).reshape(blocks.shape[0], -1)
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        c = blocks.astype(np.int32)
+        e, m = (c >> 3) & 15, c & 7
+        v = np.where(e == 0, m * 2.0 ** -9, (8 + m) * np.power(2.0, e - 10))
+        v = np.where((e == 15) & (m == 7), np.nan, v)
+        return np.where(c & 128, -v, v).astype(np.float32)
+
+
