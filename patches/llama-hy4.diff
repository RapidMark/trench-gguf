+std::unique_ptr<llm_graph_context> llama_model_hy_v4_flash::build_arch_graph(const llm_graph_params & params) const {
+    if (params.gtype == LLM_GRAPH_TYPE_DECODER_MTP) {
+        throw std::runtime_error("hy_v4_flash: no MTP / dfly drafter graph");
+    }
+    return std::make_unique<graph>(*this, params);
+}
+
+int llama_model_hy_v4_flash::engram_index(int il) const {
+    if (hparams.ple_n_heads == 0 || !hparams.is_ple(il)) {
+        return -1;
+    }
+    int e = 0;
+    for (int j = 0; j < il; ++j) {
+        e += hparams.is_ple(j);
+    }
+    return e;
+}
+
+// the n-gram rows of Engram module e: the token's normalized id and the ones before it (the pad's id before the
+// sequence start and for ids past the map) times the module's odd multipliers, xor-ed into the 2..n-gram mixes;
+// head h of order n reads row offset[h] + mix % prime[h]
+void llama_model_hy_v4_flash::engram_hash(int e, const llama_ubatch & ubatch, const std::vector<llama_token> & prev, std::vector<int32_t> & out) const {
+    const int64_t n_gram = hparams.ple_ngram_size;
+    const int64_t n_prev = n_gram - 1;
+    const int64_t n_head = hparams.ple_heads_per_ngram;
+    const int64_t n_cols = hparams.ple_n_heads;
+
+    const uint64_t * mult   = hparams.ple_layer_multipliers.data() + (size_t) e*n_gram;
+    const uint32_t * primes = hparams.ple_head_vocab_sizes.data()  + (size_t) e*n_cols;
+    const uint32_t * offs   = hparams.ple_head_offsets.data()      + (size_t) e*n_cols;
+    const int64_t    n_map  = (int64_t) engram_token_map.size();
+    const uint64_t   cpad   = (uint64_t) engram_token_map[hparams.engram_pad_id];
+
+    const auto cid = [&](llama_token t) -> uint64_t {
+        return t >= 0 && t < n_map ? (uint64_t) engram_token_map[t] : cpad;
+    };
+
+    out.resize((size_t) ubatch.n_tokens*n_cols);
+    std::vector<uint64_t> toks(n_gram);
+    for (int64_t i = 0; i < ubatch.n_tokens; ++i) {
+        const bool is_embd = !ubatch.token || (ubatch.is_mixed() && ubatch.type[i]);
+        toks[0] = is_embd ? cpad : cid(ubatch.token[i]);
+        for (int64_t s = 1; s < n_gram; ++s) {
+            toks[s] = ubatch.pos[i] - s < 0 ? cpad : cid(prev[i*n_prev + (n_prev - s)]);
+        }
+        uint64_t mix = toks[0]*mult[0];
+        for (int64_t o = 1; o < n_gram; ++o) {
+            mix ^= toks[o]*mult[o];
+            for (int64_t h = 0; h < n_head; ++h) {
+                const int64_t col = (o - 1)*n_head + h;
+                out[i*n_cols + col] = (int32_t) (mix % primes[col] + offs[col]);
+            }
+        }
+    }
+}
+
+// Engram rows, the token keep mask and the indexer's group tables
+class llm_graph_input_hy4 : public llm_graph_input_i {
+public:
+    llm_graph_input_hy4(const llama_model_hy_v4_flash & model, const llama_kv_cache_dsa_iswa_context * mctx) :
+        model(model), mctx(mctx) {}
+
+    void set_input(const llama_ubatch * ubatch) override;
+
+    std::vector<ggml_tensor *> engram_ids;  // I32 [n_cols*n_tokens], one per Engram layer
+    ggml_tensor * engram_keep = nullptr;    // F32 [1, 1, n_tokens]: 0 at pad / image / video / embedding tokens
+    ggml_tensor * grp_pos     = nullptr;    // I32 [n_grp]: the position of each group's first key (kpool*g)
+    ggml_tensor * grp_mask    = nullptr;    // F32 [n_grp, n_tokens]: ~0 for the complete groups before the query's own one
+    ggml_tensor * grp_cells   = nullptr;    // I32 [kpool, n_grp]: the cells of each group
+    ggml_tensor * own_cells   = nullptr;    // I32 [kpool, n_tokens]: the cells of the query's own group
+
+    const llama_model_hy_v4_flash & model;
+    const llama_kv_cache_dsa_iswa_context * mctx;
+};
+
+void llm_graph_input_hy4::set_input(const llama_ubatch * ubatch) {
+    const auto & hp = model.hparams;
+    const int64_t nt = ubatch->n_tokens;
+
+    if (!engram_ids.empty()) {
+        std::vector<llama_token> prev;
+        mctx->get_swa()->get_prev_tokens(*ubatch, hp.ple_ngram_size - 1, prev);
+        std::vector<std::vector<int32_t>> ids(engram_ids.size());
+        std::vector<int32_t> all;
+        for (size_t e = 0; e < engram_ids.size(); ++e) {
+            model.engram_hash((int) e, *ubatch, prev, ids[e]);
+            all.insert(all.end(), ids[e].begin(), ids[e].end());
+        }
+        if (model.can_prefetch.count(model.per_layer_tok_embd)) {
+            llama_prefetch_rows(model.per_layer_tok_embd, all.data(), all.size());
+        }
+        for (size_t e = 0; e < engram_ids.size(); ++e) {
+            if (engram_ids[e]->buffer) {
+                ggml_backend_tensor_set(engram_ids[e], ids[e].data(), 0, ids[e].size()*sizeof(int32_t));
+            }
+        }
+    }
+
+    if (engram_keep && engram_keep->buffer) {
+        std::vector<float> keep(nt);
+        for (int64_t i = 0; i < nt; ++i) {
+            const bool is_embd = !ubatch->token || (ubatch->is_mixed() && ubatch->type[i]);
+            const llama_token t = is_embd ? LLAMA_TOKEN_NULL : ubatch->token[i];
+            keep[i] = is_embd || t == (llama_token) hp.engram_pad_id || t == HY4_IMAGE_TOKEN || t == HY4_VIDEO_TOKEN ? 0.0f : 1.0f;
+        }
+        ggml_backend_tensor_set(engram_keep, keep.data(), 0, keep.size()*sizeof(float));
+    }
+
+    const int64_t kpool = hp.indexer_kpool;
+    if (grp_pos && grp_pos->buffer) {
+        const int64_t n_grp = grp_pos->ne[0];
+        std::vector<int32_t> v(n_grp);
+        for (int64_t g = 0; g < n_grp; ++g) {
+            v[g] = (int32_t) (g*kpool);
+        }
+        ggml_backend_tensor_set(grp_pos, v.data(), 0, v.size()*sizeof(int32_t));
+    }
+    if (grp_mask && grp_mask->buffer) {
+        const int64_t n_grp = grp_mask->ne[0];
+        std::vector<float> v(n_grp*nt);
+        for (int64_t i = 0; i < nt; ++i) {
+            const int64_t own = ubatch->pos[i]/kpool;
+            for (int64_t g = 0; g < n_grp; ++g) {
+                // exact ties (all heads' relu at 0) go to the earlier group, as a stable sort would order them;
+                // the offset is far below the rounding of any nonzero score
+                v[i*n_grp + g] = g < own ? -1e-30f*(float) g : -INFINITY;
+            }
+        }
+        ggml_backend_tensor_set(grp_mask, v.data(), 0, v.size()*sizeof(float));
+    }
+    if (grp_cells && grp_cells->buffer) {
+        const int64_t n_grp = grp_cells->ne[1];
+        std::vector<int32_t> v(kpool*n_grp);
+        for (int64_t g = 0; g < n_grp; ++g) {
+            for (int64_t j = 0; j < kpool; ++j) {
+                v[g*kpool + j] = (int32_t) (g*kpool + j);
+            }
+        }
+        ggml_backend_tensor_set(grp_cells, v.data(), 0, v.size()*sizeof(int32_t));
+    }
+    if (own_cells && own_cells->buffer) {
+        std::vector<int32_t> v(kpool*nt);
+        for (int64_t i = 0; i < nt; ++i) {
+            if (ubatch->n_seq_id[i] != 1 || ubatch->seq_id[i][0] != ubatch->seq_id[0][0]) {
+                throw std::runtime_error("hy_v4_flash: the indexer's group selection (context past indexer.top_k) supports one sequence per batch");
+            }
+            const int64_t own = ubatch->pos[i]/kpool;
+            for (int64_t j = 0; j < kpool; ++j) {
+                v[i*kpool + j] = (int32_t) (own*kpool + j);
+            }
+        }
+        ggml_backend_tensor_set(own_cells, v.data(), 0, v.size()*sizeof(int32_t));
+    }
+}
+
+// mixes of a hyper-connection: [2*hc, n_tokens] (or [hc, n_tokens] for the head)
+static ggml_tensor * hy4_hc_mixes(ggml_context * ctx, ggml_tensor * R, ggml_tensor * fn, float eps) {
+    ggml_tensor * flat = ggml_reshape_2d(ctx, R, R->ne[0]*R->ne[1], R->ne[2]);
+    return ggml_mul_mat(ctx, fn, ggml_rms_norm(ctx, flat, eps));
+}
+
+// sigmoid(mix*scale + base)*mag + eps over the hc rows starting at row r0 of mixes
+static ggml_tensor * hy4_hc_gate(ggml_context * ctx, ggml_tensor * mixes, ggml_tensor * scale, int64_t i_scale,
+        ggml_tensor * base, int64_t r0, int64_t hc, float mag, float eps) {
+    ggml_tensor * m = ggml_view_2d(ctx, mixes, hc, mixes->ne[1], mixes->nb[1], r0*ggml_element_size(mixes));
+    ggml_tensor * s = ggml_view_1d(ctx, scale, 1, i_scale*ggml_element_size(scale));
+    ggml_tensor * b = ggml_view_1d(ctx, base, hc, r0*ggml_element_size(base));
+    ggml_tensor * g = ggml_sigmoid(ctx, ggml_add(ctx, ggml_mul(ctx, m, s), b));
+    return ggml_scale_bias(ctx, g, mag, eps);   // [hc, n_tokens]
+}
+
+// sum_c w[c, t] * R[:, c, t]
+static ggml_tensor * hy4_hc_collapse(ggml_context * ctx, ggml_tensor * R, ggml_tensor * w) {
+    const int64_t hc = R->ne[1];
+    const int64_t nt = R->ne[2];
+    ggml_tensor * out = nullptr;
+    for (int64_t c = 0; c < hc; ++c) {
+        ggml_tensor * rc = ggml_view_2d(ctx, R, R->ne[0], nt, R->nb[2], c*R->nb[1]);
+        ggml_tensor * wc = ggml_view_2d(ctx, w, 1, nt, w->nb[1], c*w->nb[0]);
+        ggml_tensor * cur = ggml_mul(ctx, rc, wc);
+        out = out ? ggml_add(ctx, out, cur) : cur;
+    }
+    return out;   // [n_embd, n_tokens]
+}
+
+// R + post[c, t] * x[:, t] on every stream
+static ggml_tensor * hy4_hc_add(ggml_context * ctx, ggml_tensor * R, ggml_tensor * x, ggml_tensor * post) {
+    const int64_t n_embd = R->ne[0];
+    const int64_t hc     = R->ne[1];
+    const int64_t nt     = R->ne[2];
+    ggml_tensor * xr = ggml_repeat_4d(ctx, ggml_reshape_3d(ctx, x, n_embd, 1, nt), n_embd, hc, nt, 1);
+    ggml_tensor * p  = ggml_reshape_3d(ctx, post, 1, hc, nt);
+    return ggml_add(ctx, R, ggml_mul(ctx, xr, p));
+}
+
+llama_model_hy_v4_flash::graph::graph(const llama_model & model_base, const llm_graph_params & params) :
+    llm_graph_context(params) {
+    const auto & model = static_cast<const llama_model_hy_v4_flash &>(model_base);
+
+    const int64_t hc            = hparams.dsv4_hc_mult;
+    const float   hc_eps        = hparams.dsv4_hc_eps;
+    const float   hc_mag        = hparams.hc_magnitude;
+    const int64_t kv_lora_rank  = hparams.n_lora_kv;
+    const int64_t n_embd_head_k = hparams.n_embd_head_k_mla();
+    const int64_t n_embd_head_v = hparams.n_embd_head_v_mla();
+    const int64_t n_rope        = hparams.n_rot();
+    const int64_t n_nope        = n_embd_head_k - n_rope;
+    const int64_t n_idx_embd    = hparams.indexer_head_size;
+    const int64_t n_idx_head    = hparams.indexer_n_head;
+    const int64_t kpool         = hparams.indexer_kpool;
+    const int64_t n_top_grp     = hparams.indexer_top_k/kpool - 1;     // plus the own group
+    const float   kq_scale      = 1.0f/sqrtf((float) n_embd_head_k);
+
+    ggml_tensor * inp_pos     = build_inp_pos();
+    ggml_tensor * inp_out_ids = build_inp_out_ids();
+
+    llm_graph_input_attn_k_dsa_iswa * inp_attn = build_attn_inp_k_dsa_iswa();
+    llm_graph_input_attn_k_dsa      * inp_dsa  = inp_attn->get_dsa();
+
+    const auto * mctx_mla = inp_dsa->mctx->get_mla();
+    const auto * mctx_lid = inp_dsa->mctx->get_lid();
+
+    auto inp_hy4 = std::make_unique<llm_graph_input_hy4>(model, inp_attn->mctx);
+
+    // Engram rows, all modules looked up before the first layer
+    std::vector<ggml_tensor *> engram_rows;
+    if (hparams.ple_n_heads > 0) {
+        for (uint32_t e = 0; e < hparams.ple_n_modules; ++e) {
+            ggml_tensor * ids = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, (int64_t) hparams.ple_n_heads*n_tokens);
+            ggml_set_name(ids, ("engram_ids-" + std::to_string(e)).c_str());
+            ggml_set_input(ids);
+            inp_hy4->engram_ids.push_back(ids);
+            ggml_tensor * rows = ggml_get_rows(ctx0, model.per_layer_tok_embd, ids);   // [head_dim, n_cols*n_tokens]
+            engram_rows.push_back(rows);
+        }
+        inp_hy4->engram_keep = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, 1, 1, n_tokens);
+        ggml_set_input(inp_hy4->engram_keep);
+        ggml_set_name(inp_hy4->engram_keep, "engram_keep");
+    }
+
+    // the indexer's groups over the cells of the DSA cache
+    const int64_t n_kv_dsa = inp_dsa->get_kq_mask_mla()->ne[0];
+    const int64_t n_grp    = n_kv_dsa/kpool;
+    // the selection changes something only for a query past indexer.top_k keys (position >= top_k): before that it
+    // keeps every earlier group. Without one, the scores are still computed (imatrix statistics of the indexer)
+    llama_pos max_pos = 0;
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        max_pos = std::max(max_pos, ubatch.pos[i]);
+    }
+    const bool idx_sel = max_pos >= (llama_pos) hparams.indexer_top_k && n_grp > n_top_grp;
+    GGML_ASSERT(n_kv_dsa % kpool == 0);
+    {
+        inp_hy4->grp_pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_grp);
+        ggml_set_input(inp_hy4->grp_pos);
+        inp_hy4->grp_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_grp, n_tokens);
+        ggml_set_input(inp_hy4->grp_mask);
+        if (idx_sel) {
+            GGML_ASSERT(inp_dsa->get_kq_mask_mla()->ne[3] == 1 && "hy_v4_flash: the indexer's group selection needs one KV stream");
+            inp_hy4->grp_cells = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, kpool, n_grp);
+            ggml_set_input(inp_hy4->grp_cells);
+            inp_hy4->own_cells = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, kpool, n_tokens);
+            ggml_set_input(inp_hy4->own_cells);
+        }
+    }
+    llm_graph_input_hy4 * inp_h = (llm_graph_input_hy4 *) res->add_input(std::move(inp_hy4));
+
+    // the residual: hc copies of the token embedding
+    ggml_tensor * emb = build_inp_embd(model.tok_embd);
+    ggml_tensor * R = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, emb, n_embd, 1, n_tokens), n_embd, hc, n_tokens, 1);
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer = model.layers[il];
+        const bool    is_swa   = hparams.is_swa(il);
+        const int64_t n_head_l = hparams.n_head(il);
+        const float   base_l   = model.get_rope_freq_base(cparams, il);
+
+        // ---- Engram
+        if (const int e = model.engram_index(il); e >= 0) {
+            const int64_t hd = hparams.ple_head_dim;
+            const int64_t nc = hparams.ple_n_heads;
+            ggml_tensor * rows = ggml_rms_norm(ctx0, engram_rows[e], HY4_ENGRAM_ROW_EPS);
+            rows = ggml_mul(ctx0, ggml_reshape_3d(ctx0, rows, hd, nc, n_tokens), layer.engram_lookup_norm);
+            rows = ggml_reshape_2d(ctx0, rows, hd*nc, n_tokens);
+            cb(rows, "engram_rows", il);
+
+            ggml_tensor * kv = build_lora_mm(layer.engram_kv, rows);                     // [n_embd*(hc+1), n_tokens]
+            kv = ggml_add(ctx0, kv, ggml_reshape_1d(ctx0, layer.engram_kv_b, n_embd*(hc + 1)));
+            kv = ggml_reshape_3d(ctx0, kv, n_embd, hc + 1, n_tokens);
+            cb(kv, "engram_kv", il);
+
+            ggml_tensor * key   = ggml_view_3d(ctx0, kv, n_embd, hc, n_tokens, kv->nb[1], kv->nb[2], 0);
+            ggml_tensor * value = ggml_view_3d(ctx0, kv, n_embd, 1,  n_tokens, kv->nb[1], kv->nb[2], hc*kv->nb[1]);
+
+            ggml_tensor * main = ggml_mul(ctx0, ggml_rms_norm(ctx0, ggml_cont(ctx0, value), HY4_ENGRAM_EPS), layer.engram_pre_gamma);
+            ggml_tensor * dot  = ggml_mul(ctx0, ggml_rms_norm(ctx0, ggml_cont(ctx0, key), HY4_ENGRAM_EPS), ggml_rms_norm(ctx0, R, HY4_ENGRAM_EPS));
+            dot = ggml_scale(ctx0, ggml_sum_rows(ctx0, ggml_mul(ctx0, dot, layer.engram_gate)), 1.0f/sqrtf((float) n_embd));   // [1, hc, n_tokens]
+            cb(dot, "engram_dot", il);
+
+            // sigmoid(sign(dot)*sqrt(max(|dot|, 1e-6)))
+            ggml_tensor * mag  = ggml_sqrt(ctx0, ggml_clamp(ctx0, ggml_abs(ctx0, dot), 1e-6f, INFINITY));
+            ggml_tensor * sign = ggml_scale_bias(ctx0, ggml_step(ctx0, ggml_neg(ctx0, dot)), -2.0f, 1.0f);
+            ggml_tensor * gate = ggml_sigmoid(ctx0, ggml_mul(ctx0, mag, sign));
+            gate = ggml_mul(ctx0, gate, inp_h->engram_keep);
+            cb(gate, "engram_gate", il);
+
+            ggml_tensor * mrep = ggml_repeat_4d(ctx0, main, n_embd, hc, n_tokens, 1);
+            ggml_tensor * add  = ggml_add(ctx0, ggml_mul(ctx0, mrep, gate),
+                                          ggml_mul(ctx0, ggml_mul(ctx0, mrep, layer.engram_hc_scale), inp_h->engram_keep));
+            cb(add, "engram_out", il);
+            R = ggml_add(ctx0, R, add);
+        }
+
+        // ---- attention
+        ggml_tensor * mixes = hy4_hc_mixes(ctx0, R, layer.hc_attn_fn, norm_rms_eps);
+        ggml_tensor * pre   = hy4_hc_gate(ctx0, mixes, layer.hc_attn_scale, 0, layer.hc_attn_base, 0,  hc, 1.0f,   hc_eps);
+        ggml_tensor * post  = hy4_hc_gate(ctx0, mixes, layer.hc_attn_scale, 1, layer.hc_attn_base, hc, hc, hc_mag, hc_eps);
+        ggml_tensor * x = hy4_hc_collapse(ctx0, R, pre);
+        x = build_norm(x, layer.attn_norm, nullptr, LLM_NORM_RMS, il);
+        cb(x, "attn_norm", il);
+
+        {
+            ggml_tensor * qr = build_norm(build_lora_mm(layer.wq_a, x), layer.attn_q_a_norm, nullptr, LLM_NORM_RMS, il);
+            cb(qr, "qr", il);
+
+            ggml_tensor * q = ggml_reshape_3d(ctx0, build_lora_mm(layer.wq_b, qr), n_embd_head_k, n_head_l, n_tokens);
+            ggml_tensor * q_nope = ggml_view_3d(ctx0, q, n_nope, n_head_l, n_tokens, q->nb[1], q->nb[2], 0);
+            ggml_tensor * q_pe   = ggml_view_3d(ctx0, q, n_rope, n_head_l, n_tokens, q->nb[1], q->nb[2], ggml_row_size(q->type, n_nope));
+            q_pe = ggml_rope_ext(ctx0, q_pe, inp_pos, nullptr, n_rope, rope_type, n_ctx_orig, base_l, freq_scale,
+                                 ext_factor, attn_factor, beta_fast, beta_slow);
+            cb(q_pe, "q_pe", il);
+
+            ggml_tensor * kv_pe = build_lora_mm(layer.wkv_a_mqa, x);
+            ggml_tensor * kv_c  = ggml_view_2d(ctx0, kv_pe, kv_lora_rank, n_tokens, kv_pe->nb[1], 0);
+            ggml_tensor * k_pe  = ggml_view_3d(ctx0, kv_pe, n_rope, 1, n_tokens, kv_pe->nb[1], kv_pe->nb[1],
+                                               ggml_row_size(kv_pe->type, kv_lora_rank));
+            k_pe = ggml_rope_ext(ctx0, k_pe, inp_pos, nullptr, n_rope, rope_type, n_ctx_orig, base_l, freq_scale,
+                                 ext_factor, attn_factor, beta_fast, beta_slow);
+            kv_c = build_norm(kv_c, layer.attn_kv_a_norm, nullptr, LLM_NORM_RMS, il);
+            cb(kv_c, "kv_cmpr", il);
+
+            // absorbed MLA: q_nope through k_b into the latent space, one shared K/V row (latent | rope)
+            ggml_tensor * q_abs = ggml_mul_mat(ctx0, layer.wk_b, ggml_permute(ctx0, q_nope, 0, 2, 1, 3));
+            q_abs = ggml_permute(ctx0, q_abs, 0, 2, 1, 3);                         // [kv_lora, n_head, n_tokens]
+            ggml_tensor * Qcur = ggml_concat(ctx0, q_abs, q_pe, 0);
+            ggml_tensor * Kcur = ggml_concat(ctx0, ggml_reshape_3d(ctx0, kv_c, kv_lora_rank, 1, n_tokens), k_pe, 0);
+            ggml_tensor * Vcur = ggml_reshape_3d(ctx0, kv_c, kv_lora_rank, 1, n_tokens);
+            cb(Qcur, "Qcur", il);
+            cb(Kcur, "Kcur", il);
+
+            ggml_tensor * cur = nullptr;
+            if (is_swa) {
+                cur = build_attn(inp_attn->get_swa(), nullptr, nullptr, nullptr,
+                        Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, layer.wv_b, kq_scale, il);
+            } else {
+                // the compressed indexer: per-token keys into the indexer cache, kpool of them pooled per group
+                ggml_tensor * tk = build_norm(build_lora_mm(layer.indexer_attn_k, x), layer.indexer_k_norm, nullptr, LLM_NORM_RMS, il);
+                cb(tk, "indexer_tk", il);
+                ggml_build_forward_expand(gf, mctx_lid->cpy_k(ctx0, ggml_reshape_3d(ctx0, tk, n_idx_embd, 1, n_tokens),
+                                                              inp_dsa->get_k_idxs_lid(), il));
+
+                ggml_tensor * tka = mctx_lid->get_k(ctx0, il);                     // [idx_embd, 1, n_kv, n_stream]
+                // the first KV stream (the only one when selecting; several only in short multi-sequence batches,
+                // where the scores feed nothing but the statistics)
+                tka = ggml_view_2d(ctx0, tka, n_idx_embd, n_kv_dsa, tka->nb[2], 0);
+                tka = ggml_cast(ctx0, tka, GGML_TYPE_F32);
+                ggml_tensor * vals  = ggml_mul_mat(ctx0, layer.indexer_comp_value, tka);  // [idx_embd, n_kv]
+                ggml_tensor * gates = ggml_mul_mat(ctx0, layer.indexer_comp_wgate, tka);
+                gates = ggml_add(ctx0, ggml_reshape_3d(ctx0, gates, n_idx_embd, kpool, n_grp), layer.indexer_comp_ape);
+                // softmax over the kpool members of each group, per dimension
+                gates = ggml_soft_max(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, gates, 1, 0, 2, 3)));  // [kpool, idx_embd, n_grp]
+                vals  = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, vals, n_idx_embd, kpool, n_grp), 1, 0, 2, 3));
+                ggml_tensor * pooled = ggml_sum_rows(ctx0, ggml_mul(ctx0, vals, gates));                  // [1, idx_embd, n_grp]
+                pooled = ggml_reshape_2d(ctx0, pooled, n_idx_embd, n_grp);
+                pooled = build_norm(pooled, layer.indexer_comp_norm, nullptr, LLM_NORM_RMS, il);
+                pooled = ggml_rope_ext(ctx0, ggml_reshape_3d(ctx0, pooled, n_idx_embd, 1, n_grp), inp_h->grp_pos, nullptr,
+                                       n_rope, rope_type, n_ctx_orig, base_l, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow);
+                pooled = ggml_rope_set_offset(pooled, n_idx_embd - n_rope);
+                cb(pooled, "indexer_pooled", il);
+
+                ggml_tensor * iq = ggml_reshape_3d(ctx0, build_lora_mm(layer.indexer_attn_q_b, qr), n_idx_embd, n_idx_head, n_tokens);
+                iq = ggml_rope_ext(ctx0, iq, inp_pos, nullptr, n_rope, rope_type, n_ctx_orig, base_l, freq_scale,
+                                   ext_factor, attn_factor, beta_fast, beta_slow);
+                iq = ggml_rope_set_offset(iq, n_idx_embd - n_rope);
+                ggml_tensor * iw = ggml_scale(ctx0, build_lora_mm(layer.indexer_proj, x), 1.0f/sqrtf((float) (n_idx_head*n_idx_embd)));
+
+                ggml_tensor * sc = ggml_mul_mat(ctx0, ggml_reshape_2d(ctx0, pooled, n_idx_embd, n_grp),
+                                                ggml_reshape_2d(ctx0, iq, n_idx_embd, n_idx_head*n_tokens));   // [n_grp, n_head*n_tokens]
+                sc = ggml_relu(ctx0, sc);
+                sc = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, sc, n_grp, n_idx_head, n_tokens), 1, 0, 2, 3));  // [n_head, n_grp, n_tokens]
+                sc = ggml_mul(ctx0, sc, ggml_reshape_3d(ctx0, iw, n_idx_head, 1, n_tokens));
+                sc = ggml_reshape_2d(ctx0, ggml_sum_rows(ctx0, sc), n_grp, n_tokens);   // [n_grp, n_tokens]
+                sc = ggml_add(ctx0, sc, inp_h->grp_mask);
+                cb(sc, "indexer_score", il);
+
+                // store this ubatch's K and attend over the DSA cache
+                ggml_build_forward_expand(gf, Qcur);
+                ggml_build_forward_expand(gf, Kcur);
+                ggml_build_forward_expand(gf, mctx_mla->cpy_k(ctx0, Kcur, inp_dsa->get_k_idxs_mla(), il));
+
+                ggml_tensor * kq_mask = inp_dsa->get_kq_mask_mla();
+                if (idx_sel) {
+                    ggml_tensor * top = ggml_top_k(ctx0, sc, n_top_grp);                // [n_top_grp, n_tokens]
+                    cb(top, "indexer_top_k", il);
+                    kq_mask = ggml_top_k_mask(ctx0, kq_mask,
+                            ggml_reshape_4d(ctx0, top, top->ne[0], kq_mask->ne[1], kq_mask->ne[2], kq_mask->ne[3]),
+                            ggml_reshape_4d(ctx0, sc,  sc->ne[0],  kq_mask->ne[1], kq_mask->ne[2], kq_mask->ne[3]),
+                            inp_h->grp_cells,
+                            ggml_reshape_4d(ctx0, inp_h->own_cells, kpool, kq_mask->ne[1], kq_mask->ne[2], kq_mask->ne[3]));
+                    cb(kq_mask, "indexer_kq_mask", il);
+                } else {
+                    // nothing to select yet; keep the scores in the graph (imatrix statistics of the indexer weights)
+                    ggml_build_forward_expand(gf, sc);
+                }
+
+                ggml_tensor * k = mctx_mla->get_k(ctx0, il);
+                ggml_tensor * v = ggml_view_4d(ctx0, k, kv_lora_rank, k->ne[1], k->ne[2], k->ne[3], k->nb[1], k->nb[2], k->nb[3], 0);
+                cur = build_attn_mha(Qcur, k, v, nullptr, kq_mask, layer.attn_sinks, layer.wv_b, k->ne[2], kq_scale, il);
+            }
+            cb(cur, "attn_kqv", il);
+
+            ggml_tensor * gate = ggml_sigmoid(ctx0, build_lora_mm(layer.wqkv_gate, x));
+            cur = ggml_mul(ctx0, ggml_reshape_2d(ctx0, cur, n_embd_head_v*n_head_l, n_tokens), gate);
+            cur = build_lora_mm(layer.wo, cur);
+            cur = build_norm(cur, layer.attn_post_norm, nullptr, LLM_NORM_RMS, il);
+            cb(cur, "attn_out", il);
+
+            R = hy4_hc_add(ctx0, R, cur, post);
+        }
+
+        // ---- FFN
+        mixes = hy4_hc_mixes(ctx0, R, layer.hc_ffn_fn, norm_rms_eps);
+        pre   = hy4_hc_gate(ctx0, mixes, layer.hc_ffn_scale, 0, layer.hc_ffn_base, 0,  hc, 1.0f,   hc_eps);
+        post  = hy4_hc_gate(ctx0, mixes, layer.hc_ffn_scale, 1, layer.hc_ffn_base, hc, hc, hc_mag, hc_eps);
+        x = hy4_hc_collapse(ctx0, R, pre);
+        x = build_norm(x, layer.ffn_norm, nullptr, LLM_NORM_RMS, il);
+        cb(x, "ffn_norm", il);
+
+        ggml_tensor * f = nullptr;
+        if ((uint32_t) il < hparams.n_layer_dense_lead) {
+            f = build_ffn(x,
+                    layer.ffn_up,   nullptr, nullptr,
+                    layer.ffn_gate, nullptr, nullptr,
+                    layer.ffn_down, nullptr, nullptr,
+                    nullptr, LLM_FFN_SILU, LLM_FFN_PAR, il);
+        } else {
+            // the router scores x, the routed experts run on the latent projection of x
+            ggml_tensor * logits = build_lora_mm(layer.ffn_gate_inp, x);
+            cb(logits, "ffn_moe_logits", il);
+            ggml_tensor * xl = build_lora_mm(layer.ffn_routed_down, x);
+            cb(xl, "ffn_routed_in", il);
+            ggml_tensor * moe = build_moe_ffn(xl,
+                    nullptr,
+                    layer.ffn_up_exps,
+                    layer.ffn_gate_exps,
+                    layer.ffn_down_exps,
+                    layer.ffn_exp_probs_b,
+                    n_expert, n_expert_used,
+                    LLM_FFN_SILU, hparams.expert_weights_norm,
+                    hparams.expert_weights_scale,
+                    (llama_expert_gating_func_type) hparams.expert_gating_func,
+                    il,
+                    logits);
+            cb(moe, "ffn_moe_out", il);
+            moe = build_lora_mm(layer.ffn_routed_up, moe);
+
+            ggml_tensor * sh = build_ffn(x,
+                    layer.ffn_up_shexp,   nullptr, nullptr,
+                    layer.ffn_gate_shexp, nullptr, nullptr,
+                    layer.ffn_down_shexp, nullptr, nullptr,
+                    nullptr, LLM_FFN_SILU, LLM_FFN_PAR, il);
+            cb(sh, "ffn_shexp", il);
+            f = ggml_add(ctx0, moe, sh);
+        }
+        f = build_norm(f, layer.ffn_post_norm, nullptr, LLM_NORM_RMS, il);
+        cb(f, "ffn_out", il);
+
+        R = hy4_hc_add(ctx0, R, f, post);
+        cb(R, "l_out", il);
+    }
+
+    if (inp_out_ids) {
+        R = ggml_get_rows(ctx0, ggml_reshape_2d(ctx0, R, n_embd*hc, n_tokens), inp_out_ids);
+        R = ggml_reshape_3d(ctx0, R, n_embd, hc, R->ne[1]);
+    }
+
+    // head: collapse the streams
+    ggml_tensor * hm  = hy4_hc_mixes(ctx0, R, model.hc_head_fn, norm_rms_eps);
+    ggml_tensor * hp  = hy4_hc_gate(ctx0, hm, model.hc_head_scale, 0, model.hc_head_base, 0, hc, 1.0f, hc_eps);
+    ggml_tensor * cur = hy4_hc_collapse(ctx0, R, hp);
+
+    cur = build_norm(cur, model.output_norm, nullptr, LLM_NORM_RMS, -1);
+    cb(cur, "result_norm", -1);
+    res->t_embd = cur;
+
+    cur = build_lora_mm(model.output, cur);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
